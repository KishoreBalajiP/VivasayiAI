# Backend environment variables — placeholder values only, never commit real secrets.
# Copy this file to .env and fill in real values. See docs/engineering/14_Deployment.md §4.

# Local server
PORT=8000

# CORS allowed origins (comma-separated; add production frontend domain here)
CORS_ORIGINS=http://localhost:5173

# Rate limiting — auth (per IP) and chat (per user)
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30
CHAT_DAILY_RATE_LIMIT_WINDOW_MS=86400000
CHAT_DAILY_RATE_LIMIT_MAX=300

# Session mutation rate limiting — per user, POST/DELETE on /chatsessions (E1-S8)
SESSION_MUTATION_RATE_LIMIT_WINDOW_MS=60000
SESSION_MUTATION_RATE_LIMIT_MAX=30

# Image upload (E3) — per user, multipart POST /upload; in-memory size cap (D-22 Option 1)
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=10
IMAGE_UPLOAD_MAX_BYTES=5242880

# Image normalization (E3, D-22 Option 1): stored image's longest edge is capped at this
# (configurable default pending product tuning; the pipeline never enlarges).
IMAGE_MAX_DIMENSION=2048
# Object-key namespace inside S3_BUCKET for uploads (kept apart from dataset/ingestion keys).
UPLOAD_STORAGE_PREFIX=uploads
# Short-lived signed GET URL lifetime (seconds) for authorized chat-image retrieval
# (GET /upload/:uploadId/view). Minted on demand when chat history is reconstructed; never
# persisted. Keep short — 300 is the default.
IMAGE_VIEW_URL_TTL_SECONDS=300
# Dev/test-only seams — server-side environment config, never client-controlled:
#   IMAGE_STORAGE_MODE=mock  in-memory S3 stub (deterministic regression, no AWS needed)
#   IMAGE_AI_MODE=mock       canned vision/analysis output (deterministic regression, no Gemini)
# Leave unset ("live") in real environments.
# IMAGE_STORAGE_MODE=mock
# IMAGE_AI_MODE=mock
# More dev/e2e-only seams (ADR-024, the hermetic e2e harness `npm run e2e:backend`, which sets them
# all from scripts/e2e/e2e.env). A production process (NODE_ENV=production or on Lambda) REFUSES TO
# BOOT if any of them, or any mock mode above, is set (config/env.js assertProductionSafety):
#   IMAGE_STORAGE_MOCK_DIR=<dir>      the mock bucket in files, shared with a separate worker process
#   DEV_STORAGE_RECEIVER=true         mount /__dev/storage, a signed PUT/GET stand-in for S3 presigned
#                                     URLs (mock storage only, never in production or on Lambda)
#   DEV_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:18080   where the browser reaches that receiver
#   WEATHER_MODE=live|mock|off        claim rainfall and /weather: mock answers a fixed series
#   WEATHER_MOCK_OUTCOME=available|unavailable|timeout   (read on every call)
#   SATELLITE_MODE=live|mock|off      mock runs the real adapter against an in-process stand-in provider
#   SATELLITE_MOCK_OUTCOME=imagery_found|supports_loss|no_change|cloud|provider_error   (read on every run)
# The harness itself also reads E2E_MONGO_URI (with --mongo=local), E2E_CONTROL_TOKEN and
# E2E_SESSION_JWT_SECRET (optional; random per run otherwise) and MONGOMS_SYSTEM_BINARY.

# Input validation — max characters for message/text fields (15_Security.md §5)
MESSAGE_MAX_LENGTH=2000

# Logging — pino level (error | warn | info | debug); default: info in production, debug otherwise
LOG_LEVEL=debug
NODE_ENV=development

# httpOnly session cookie name (used by requireAuth under E1-S4 / D-34)
SESSION_COOKIE_NAME=session

# E1-S3: backend-issued session tokens (ADR-013 / D-34). HMAC HS256 secret for signing our OWN
# session JWTs (NOT the Cognito key). Use a long random value, unique per environment.
SESSION_JWT_SECRET=<random-long-secret>

# Session token TTLs (milliseconds): access ~15 min, refresh ~30 days (D-34 defaults).
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=2592000000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# AWS Cognito OAuth2
COGNITO_CLIENT_ID=<cognito-client-id>
# Recommended: pin id tokens to your user pool, e.g. ap-south-1_AbCdEfGhI. Unset accepts any Cognito pool.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=<cognito-domain>
COGNITO_REDIRECT_URI=http://localhost:5173

# Gemini API key (backend chat)
GOOGLE_API_KEY=<google-api-key>

# Model Adapter (provider-agnostic AI). Phase 1 uses Gemini directly (F-45 Model Adapter is future work).
# Read by src/ai/AIConfig.js. Keep values consistent with chat pipeline config.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash

# Prompt pipeline token budgets (src/ai/AIConfig.js) — no magic numbers in code.
MAX_OUTPUT_TOKENS=2048
# Retries LangChain makes on a failed Gemini call (default 1). Higher values let a quota (429)
# response retry with backoff past the 25 s AI timeout.
# AI_MAX_RETRIES=1
# Per-call AI timeout in ms (default 25000, must stay below the API Gateway 29 s ceiling).
# GEMINI_TIMEOUT_MS=25000
# NOTE: a free-tier Gemini key allows only 20 gemini-2.5-flash requests per day; production
# needs a billed key.
CHAT_HISTORY_MESSAGES=6
MAX_INPUT_TOKENS=8192
RESERVED_OUTPUT_TOKENS=512
RAG_TOP_K=3

# S3 ingestion (ingestion only)
MY_AWS_REGION=ap-south-1
MY_AWS_ACCESS_KEY_ID=<aws-access-key-id>
MY_AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
S3_BUCKET=<s3-bucket>

# Cohere embeddings (chat + ingestion)
COHERE_API_KEY=<cohere-api-key>
EMBEDDING_MODEL=embed-english-v3.0

# ChromaDB cloud
CHROMA_API_KEY=<chroma-api-key>
CHROMA_TENANT=<chroma-tenant>
CHROMA_DATABASE=<chroma-database>

# Weather service (E2-S1) — backend proxy + Mongo cache. Open-Meteo is keyless.
# Cache TTL and staleness windows (milliseconds); defaults match 15_Security §5 / 09 §5.
WEATHER_CACHE_TTL_MS=1800000
WEATHER_FETCH_TIMEOUT_MS=5000
WEATHER_STALE_AFTER_MS=3600000
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
# Historical rainfall around a claimed event (supporting evidence only). Archive data lags a few days;
# recent events use the forecast API's past_days instead.
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1

# Agricultural Loss / Affected-Area Claim (F-49, ADR-019) — Phase 1
# Claim window (P2): how far back an event date may be, backend-authoritative.
CLAIM_WINDOW_DAYS=30
# Claim API rate limits — per user (15_Security.md §5). Defaults (config/env.js RATE_LIMIT_DEFAULTS,
# owner decision D5, ADR-022): 15 claim writes and 60 evidence calls per hour; one normal claim is
# about 4 writes (create, submit, up to 2 resubmits) and ~25 evidence calls (10 photos, documents).
CLAIM_RATE_LIMIT_WINDOW_MS=3600000
CLAIM_RATE_LIMIT_MAX=15
# Reads (GET claim / verification / appeal) use their own, larger per-user bucket so status polling
# never exhausts the write budget above.
CLAIM_READ_RATE_LIMIT_WINDOW_MS=3600000
CLAIM_READ_RATE_LIMIT_MAX=600
EVIDENCE_RATE_LIMIT_WINDOW_MS=3600000
EVIDENCE_RATE_LIMIT_MAX=60
# Evidence image limits (P9) — same pipeline caps as /upload, per claim specifically.
CLAIM_EVIDENCE_MAX_IMAGES=10
# Geometry (P5): overlap tolerance metres; area must not exceed parcel area beyond this
# fraction before flagging cross-parcel / out-of-parcel geometry (tunable, not hardcoded).
CLAIM_OVERLAP_TOLERANCE_M=1.0
CLAIM_AREA_OVERAGE_FRACTION=0.05
# Resubmission (P6): max resubmits and cooldown before a claim can be resubmitted
# from MORE_EVIDENCE_REQUIRED. Terminal states are never resubmittable.
CLAIM_MAX_RESUBMISSIONS=2
CLAIM_RESUBMIT_COOLDOWN_MS=86400000
# Weather thresholds (P3): intentionally EMPTY placeholders — weather is supporting
# evidence only in Phase 1; no hard thresholds may be set without a new ADR.
# CLAIM_WEATHER_MIN_RAIN_MM=
# CLAIM_WEATHER_MAX_TEMP_C=
# Map (P8): isolated tile source config; free OSM default. No map in Phase 1.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Satellite adapter (Phase 13.3+) — CDSE Sentinel Hub OAuth2 credentials for authenticated processing.
# Copy these to .env and fill in real values before running live processing.
# Leaving these unset (or set to empty) keeps the adapter in disabled/config-absent mode.
# See PHASE_13_3_SATELLITE_ADAPTER_REPORT.md for the exact prerequisite.
# Never commit real credentials; these are placeholder names only.

# CDSE Sentinel Hub OAuth2 client credentials (required for live NDVI processing).
# These are the primary credential variables consumed by the adapter.
CDSE_CLIENT_ID=<your-cdse-client-id>
CDSE_CLIENT_SECRET=<your-cdse-client-secret>

# SENTINEL_HUB_* aliases — also consumed by the adapter as fallbacks.
# Uncomment and set only if you prefer the SENTINEL_HUB_ namespace.
# SENTINEL_HUB_CLIENT_ID=<your-sentinel-hub-client-id>
# SENTINEL_HUB_CLIENT_SECRET=<your-sentinel-hub-client-secret>

# SATELLITE_PROCESSING_ENABLED — explicit opt-in gate for live processing.
# Default is false; set to true only when credentials are genuinely configured.
SATELLITE_PROCESSING_ENABLED=false
# Tile-level cloud limit when selecting scenes for a parcel (0-1). Per-pixel cloud masking decides the
# rest, so this is deliberately loose; 0.3 rejected nearly all monsoon-season imagery in live tests.
# SATELLITE_PROCESSING_SCENE_CLOUD_MAX=0.9

# Admin endpoints (Phase 10): per-admin rate limit, and an optional second-admin approval for overrides
# above this many acres (0 = never required).
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=120
ADMIN_OVERRIDE_APPROVER_ACRE_THRESHOLD=0

# Phase 15 automated verification. Must be true in production, together with
# CLAIM_VERIFICATION_DRAIN_ON_READ, before the farmer UI stops calling POST /verify
# (docs/engineering/WORKER_RUNBOOK.md, preflight).
CLAIM_AUTOMATED_VERIFICATION_ENABLED=true
# A status read (GET /claims/:id/progress or /verification) also runs ONE due step for the claim's
# owner, so polling moves the queue even without the scheduled worker. Its budget defaults to 20 s,
# enough for every step including the photo check (it needs 15 s), so a poll can take up to about
# 20 s. Below 15000 a poll never runs the photo check (it runs a shorter due step instead); stay
# under API Gateway's 29 s.
CLAIM_VERIFICATION_DRAIN_ON_READ=true
# CLAIM_VERIFICATION_READ_DRAIN_BUDGET_MS=20000
# Wall-clock budget (ms) POST /claims/:id/verify spends running the claim's due steps (under API
# Gateway's 29 s limit).
CLAIM_VERIFICATION_REQUEST_BUDGET_MS=22000
# Verification policy (config/verificationPolicy.js, ADR-020/ADR-022). Unknown ids fail at boot.
#   v1-legacy      historical decisions (the code default until 2026-10-16; set it to replay them)
#   v2-components  required-component gate
#   v1.1-safe-ai   v1-legacy rules, but an AI-only "no damage" reading or a provider failure holds the
#                  claim for a person (never a rejection or "more evidence"), and the claim window is
#                  measured at the claim's first submission. The code default since 2026-10-16.
# CLAIM_VERIFICATION_POLICY=v1.1-safe-ai
# VIVASAYI_SKIP_DOTENV=1 (set in the PROCESS environment, not here) stops config/env.js from loading
# this file at all; hermetic harnesses and the engine golden capture use it.
# Verification job queue (services/verificationJobs.service.js, ADR-022). Defaults shown; all optional.
#   lease a runner holds on a job, renewed by a heartbeat (default: a third of the lease)
# VERIFICATION_LEASE_MS=60000
# VERIFICATION_HEARTBEAT_MS=20000
#   retry backoff in ms after attempt 1, 2, ... (CSV; the last value repeats; each is jittered +/-20%)
# VERIFICATION_RETRY_SCHEDULE_MS=60000,300000,900000,3600000,3600000,10800000
#   attempts per step (JSON; steps not listed keep their default; an application defect stops at 3)
# VERIFICATION_MAX_ATTEMPTS={"ai_assessment":7,"land_documents":7,"official_land_record":5,"satellite":5,"weather":5,"engine":5}
#   dead jobs that failed on quota/overload/timeout/network/storage are re-queued this long after
#   they died (at most two rounds); auth_config failures need an admin or the worker CLI
# VERIFICATION_DEAD_RECOVERY_AFTER_MS=21600000
# Photo check (services/claimAssessment.service.js): per-image model budget for queued runs, the
# whole-loop budget inside an HTTP request, and when a `processing` row without a slot lease counts
# as abandoned.
# CLAIM_ASSESSMENT_PER_IMAGE_TIMEOUT_MS=25000
# CLAIM_ASSESSMENT_TIMEOUT_MS=25000
# CLAIM_ASSESSMENT_STALE_MS=600000
# scripts/migrations/2026-10-verification-automation.js refuses --apply against a mongodb+srv URI
# unless this is set (the dry run is always allowed).
# MIGRATION_ALLOW_REMOTE_APPLY=false
# Verification worker (ADR-022; `npm run worker` locally, the `index.worker` Lambda handler in
# production, docs/engineering/WORKER_RUNBOOK.md). All optional; defaults shown.
#   `npm run worker` refuses any database that is not on this machine (Atlas included) unless this
#   is true for that one command; never set it in a file that also points MONGO_URI at production.
# WORKER_ALLOW_REMOTE_DB=false
#   jobs per batch (also read by the Lambda handler), time budget per batch, idle poll interval, and
#   how often the recovery sweeps run in the local loop
# WORKER_MAX_JOBS=25
# WORKER_BATCH_BUDGET_MS=240000
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_SWEEP_INTERVAL_MS=60000
# Satellite adapter switch: `off` runs the adapter switched off (recorded as not enabled, and the farmer
# progress view reports satellite as not enabled); `mock` is dev/e2e only (see the dev/test seams above).
# SATELLITE_ENABLED=false also switches the adapter off.
# SATELLITE_MODE=live
# SATELLITE_ENABLED=true
# RAG knowledge base (config/ragConfig.js, plan A10). Chroma collection chat reads and the cloud ingest
# target writes (default: the production collection), the CSV row cap for ingestion (0 = no cap), and
# an optional key prefix that limits what `npm run ingest` reads from the bucket.
# RAG_COLLECTION=farming-documents
# RAG_MAX_ROWS_PER_FILE=0
# RAG_INGEST_PREFIX=
LAND_RECORD_MODE=live
LAND_RECORD_PROVIDER_URL=
LAND_RECORD_API_KEY=
LAND_RECORD_TIMEOUT_MS=8000
LAND_RECORD_MOCK_OUTCOME=unavailable
