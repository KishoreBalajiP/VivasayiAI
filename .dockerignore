# Keep the Lambda image to what runs in production. `COPY . .` otherwise ships the git history,
# tests, docs, phase reports and any local .env into the image.
node_modules
.git
.github
.env
.env.*
!.env.example
tests
docs
*.md
vitest.config.js
.vscode
.DS_Store
# Dev, evaluation and infrastructure material never runs in the Lambda image.
scripts/e2e
scripts/acceptance
scripts/live
scripts/eval
.rag-local
test-results
infra
