# Hermetic e2e backend environment (ADR-024, design-testing §2.1 step 1). COMMITTED; holds NO secrets.
#
# scripts/e2e/hermeticBackend.js loads this file into process.env BEFORE any application module is
# imported, and every key here OVERRIDES the shell's value. It also sets VIVASAYI_SKIP_DOTENV=1, so the
# developer's .env is never read. Values the harness fills in itself at start-up (never stored here):
#   MONGO_URI                    the mongodb-memory-server (or --mongo=local E2E_MONGO_URI) address
#   SESSION_JWT_SECRET           random per run
#   DEV_STORAGE_PUBLIC_BASE_URL  http://127.0.0.1:<port>
#   IMAGE_STORAGE_MOCK_DIR       a fresh temporary directory per run (shared with a process worker)
# The harness refuses to start if, after loading, any live credential below is non-empty, the AI keys
# are not the placeholder, or the database is not on this machine.

VIVASAYI_SKIP_DOTENV=1
NODE_ENV=development
LOG_LEVEL=warn

# --- provider and storage seams ---------------------------------------------------------------------
IMAGE_STORAGE_MODE=mock
# live on purpose: the fake Gemini replaces model.generate, so 429/503/timeout/malformed can be injected
IMAGE_AI_MODE=live
LAND_RECORD_MODE=mock
LAND_RECORD_MOCK_OUTCOME=unavailable
WEATHER_MODE=mock
WEATHER_MOCK_OUTCOME=available
SATELLITE_MODE=mock
SATELLITE_MOCK_OUTCOME=imagery_found
SATELLITE_PROCESSING_ENABLED=false
DEV_STORAGE_RECEIVER=true

# --- verification policy and queue ------------------------------------------------------------------
CLAIM_VERIFICATION_POLICY=v1.1-safe-ai
CLAIM_AUTOMATED_VERIFICATION_ENABLED=true
# only the worker moves jobs (proves D7: nothing depends on the browser polling)
CLAIM_VERIFICATION_DRAIN_ON_READ=false
CLAIM_ASSESSMENT_PER_IMAGE_TIMEOUT_MS=2000
VERIFICATION_RETRY_SCHEDULE_MS=1000,2000,4000
VERIFICATION_MAX_ATTEMPTS={"ai_assessment":3,"land_documents":3,"engine":3}
VERIFICATION_DEAD_RECOVERY_AFTER_MS=5000
VERIFICATION_LEASE_MS=15000
VERIFICATION_HEARTBEAT_MS=5000
# a fake "timeout" answer arrives this late (longer than the per-image timeout above)
E2E_FAKE_TIMEOUT_MS=6000

# --- worker (inline loop, or `--worker=process` running scripts/worker.js) --------------------------
WORKER_POLL_INTERVAL_MS=250
WORKER_BATCH_BUDGET_MS=20000
WORKER_MAX_JOBS=25
WORKER_SWEEP_INTERVAL_MS=1000

# --- auth and browser ---------------------------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
ACCESS_TOKEN_TTL_MS=7200000
# Rate limits are deliberately NOT overridden: the D5 defaults (15 claim writes, 60 evidence calls,
# 600 reads per user per hour) are what the e2e suite exercises. Each test uses a fresh farmer.

# --- placeholders (the AI, embedding and vector-store clients are constructed but never reached) ----
GOOGLE_API_KEY=e2e-placeholder
COHERE_API_KEY=e2e-placeholder
CHROMA_API_KEY=e2e-placeholder
CHROMA_TENANT=e2e-placeholder
CHROMA_DATABASE=e2e-placeholder
S3_BUCKET=e2e-mock
MY_AWS_REGION=ap-south-1

# --- every live credential is blank --------------------------------------------------------------------
MONGO_URI=
SESSION_JWT_SECRET=
MY_AWS_ACCESS_KEY_ID=
MY_AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
LAND_RECORD_PROVIDER_URL=
LAND_RECORD_API_KEY=
COGNITO_CLIENT_ID=e2e
COGNITO_CLIENT_SECRET=
COGNITO_USER_POOL_ID=
COGNITO_DOMAIN=cognito.e2e.invalid
COGNITO_REDIRECT_URI=http://127.0.0.1:15173
