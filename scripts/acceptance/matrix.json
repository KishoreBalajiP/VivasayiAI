{
  "schema": "vivasayi-acceptance-matrix/v1",
  "$comment": "Single ID registry and scenario map for plan Part F. Read by scripts/acceptance/report.js. Test titles start with '<ID>:' (e.g. 'EQ-1: ...'). Selector forms in scenarios[].tests: an exact ID ('VJ-20'); a family wildcard ('SD-*' = every test whose ID starts with 'SD-'; at least one must exist); or a file selector {repo, file, title?} meaning every test in that file whose full name matches the case-insensitive 'title' regex. Playwright results carry '@<project>' and match their base ID in every project.",
  "idPattern": "^([A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+[a-z]?):",
  "levels": {
    "U": "Backend unit: pure functions, no database",
    "I/API": "Backend integration: Express + mongodb-memory-server via tests/helpers.js",
    "FE-U": "Frontend vitest (unit and dom projects)",
    "E2E": "Playwright in the frontend against the hermetic backend harness"
  },
  "suites": {
    "backend-vitest": {
      "repo": "backend",
      "levels": [
        "U",
        "I/API"
      ],
      "rawReport": "test-results/raw/backend-vitest.json",
      "format": "vitest-json"
    },
    "frontend-vitest": {
      "repo": "frontend",
      "levels": [
        "FE-U"
      ],
      "rawReport": "test-results/raw/frontend-vitest.json",
      "format": "vitest-json"
    },
    "e2e-playwright": {
      "repo": "frontend",
      "levels": [
        "E2E"
      ],
      "rawReport": "test-results/raw/e2e-playwright.json",
      "format": "playwright-json"
    }
  },
  "levelSuites": {
    "U": "backend-vitest",
    "I/API": "backend-vitest",
    "FE-U": "frontend-vitest",
    "E2E": "e2e-playwright"
  },
  "mocks": {
    "FG": "fake Gemini on chat.service model.generate (scripts/e2e/lib/fakeGemini.js)",
    "MS": "mock storage plus the dev receiver",
    "MMS": "mongodb-memory-server",
    "SAT-M": "SATELLITE_MODE=mock",
    "WX-M": "WEATHER_MODE=mock",
    "LR-M": "LAND_RECORD_MODE=mock",
    "vi.mock": "vitest module mock",
    "PR": "Playwright route()",
    "control": "hermetic control server (/__e2e/*)",
    "slowWorkerBootstrap": "tests/fixtures/slowWorkerBootstrap.js (sleeping executor in a child worker)"
  },
  "severities": {
    "S1": "Wrong or adverse decision, data leak or lost claim",
    "S2": "Stuck claim or wrong status shown",
    "S3": "Minor UI or text",
    "S4": "Docs or cosmetic"
  },
  "defaults": {
    "unmappedFailure": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "A failing test that no scenario maps is release-blocking until triage says otherwise."
    }
  },
  "suiteDefaults": {
    "backend-vitest": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "The backend suite did not complete"
    },
    "backend-node-check": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "A backend file does not parse"
    },
    "frontend-typecheck": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "The frontend does not typecheck"
    },
    "frontend-lint": {
      "severity": "S3",
      "releaseBlocking": true,
      "reason": "Lint errors block release until triaged"
    },
    "frontend-build": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "The frontend does not build"
    },
    "frontend-vitest": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "The frontend suite did not complete"
    },
    "e2e-playwright": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "The Playwright run did not complete"
    },
    "manuscript-numbers": {
      "severity": "S4",
      "releaseBlocking": false,
      "reason": "Research integrity: prose numbers are not traceable (blocks the manuscript, not the product)"
    },
    "frozen-hashes": {
      "severity": "S2",
      "releaseBlocking": true,
      "reason": "A frozen 2026-10-16 research artifact changed"
    }
  },
